ARG UBUNTU_VERSION=26.04
FROM ubuntu:${UBUNTU_VERSION}
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
  && apt-get install -y --no-install-recommends bash ca-certificates curl git openssh-client openssh-server python3 openssl passwd sudo procps iproute2 \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /repo
COPY . /repo
