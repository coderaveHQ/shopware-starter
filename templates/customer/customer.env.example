# Customer/project identity
CUSTOMER_NAME="Example Customer GmbH"
PROJECT_SLUG="example-customer-shopware"
ADMIN_EMAIL="technik@example.com"
TECHNICAL_CONTACT_EMAIL="technik@example.com"
TIMEZONE="Europe/Berlin"

# GitHub repository that will use this template
GITHUB_OWNER="your-github-org"
GITHUB_REPO="example-customer-shopware"

# Server access created manually in IONOS before running this template.
# Use the initial root SSH key that IONOS accepts for the fresh VPS.
STAGING_SERVER_HOST="203.0.113.10"
PRODUCTION_SERVER_HOST="203.0.113.11"
STAGING_ROOT_SSH_USER="root"
PRODUCTION_ROOT_SSH_USER="root"
STAGING_ROOT_SSH_PORT="22"
PRODUCTION_ROOT_SSH_PORT="22"
STAGING_ROOT_SSH_KEY_PATH="~/.ssh/id_ed25519"
PRODUCTION_ROOT_SSH_KEY_PATH="~/.ssh/id_ed25519"

# Domains must point to the server IPs before HTTPS is enabled by Caddy.
STAGING_DOMAIN="staging.shop.example.com"
PRODUCTION_DOMAIN="shop.example.com"

# Linux users created by the server scripts
ADMIN_USER="florian"
DEPLOY_USER="deploy"
SSH_PORT="22"
DISABLE_ROOT_SSH="0"
INSTALL_BASE_DIR="/opt/shopware"

# Shopware / runtime versions and images
SHOPWARE_VERSION=""
PHP_VERSION="8.4"
MARIADB_IMAGE="mariadb:11.4"
VALKEY_IMAGE="valkey/valkey:8-alpine"
OPENSEARCH_IMAGE="opensearchproject/opensearch:2.17.1"
RABBITMQ_IMAGE="rabbitmq:3-management-alpine"
VARNISH_IMAGE="ghcr.io/shopware/varnish:6.7"
CADDY_IMAGE="caddy:2-alpine"

# Shopware install defaults
INSTALL_LOCALE="de-DE"
INSTALL_CURRENCY="EUR"
INSTALL_ADMIN_USERNAME="admin"
SHOPWARE_USAGE_DATA_CONSENT="revoked"

# Feature toggles for generated config. Variant A keeps all services on the same VPS.
ENABLE_S3="1"
ENABLE_OPENSEARCH="1"
ENABLE_RABBITMQ="1"
ENABLE_VARNISH="1"

# IONOS Object Storage / S3-compatible storage.
# Leave empty only if you intentionally adjust filesystem-s3.yaml before production use.
S3_ENDPOINT="https://s3.eu-central-1.ionoscloud.com"
S3_REGION="eu-central-1"
S3_USE_PATH_STYLE="true"
S3_PUBLIC_BUCKET="example-customer-shopware-public"
S3_PRIVATE_BUCKET="example-customer-shopware-private"
S3_BACKUP_BUCKET="example-customer-shopware-backups"
S3_PUBLIC_URL=""
S3_ACCESS_KEY="CHANGE_ME"
S3_SECRET_KEY="CHANGE_ME"

# Backups on each VPS
BACKUP_RETENTION_DAYS="14"
BACKUP_HOUR="2"
BACKUP_MINUTE="30"

# Optional Shopware Store credentials for Deployment Helper extension handling.
SHOPWARE_STORE_ACCOUNT_EMAIL=""
SHOPWARE_STORE_ACCOUNT_PASSWORD=""
SHOPWARE_STORE_SHOP_SECRET=""
SHOPWARE_STORE_LICENSE_DOMAIN=""
