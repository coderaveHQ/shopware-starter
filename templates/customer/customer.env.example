# Copy this file to customer.env and replace every CHANGE_ME value.
# This file is parsed as data, never sourced as shell code.

# Customer/project identity
CUSTOMER_NAME="CHANGE_ME Customer GmbH"
PROJECT_SLUG="change-me-shopware"
ADMIN_EMAIL="CHANGE_ME@customer.invalid"
TECHNICAL_CONTACT_EMAIL="CHANGE_ME@customer.invalid"
TIMEZONE="Europe/Berlin"

# GitHub repository
GITHUB_OWNER="CHANGE_ME"
GITHUB_REPO="change-me-shopware"

# Fresh VPS access. Obtain the ED25519 host-key fingerprint independently from
# the IONOS console before the first SSH connection.
STAGING_SERVER_HOST="CHANGE_ME"
STAGING_ROOT_SSH_USER="root"
STAGING_ROOT_SSH_PORT="22"
STAGING_ROOT_SSH_KEY_PATH="~/.ssh/id_ed25519"
STAGING_SSH_HOST_KEY_SHA256="SHA256:CHANGE_ME"
STAGING_DOMAIN="staging.CHANGE_ME.invalid"

PRODUCTION_SERVER_HOST="CHANGE_ME"
PRODUCTION_ROOT_SSH_USER="root"
PRODUCTION_ROOT_SSH_PORT="22"
PRODUCTION_ROOT_SSH_KEY_PATH="~/.ssh/id_ed25519"
PRODUCTION_SSH_HOST_KEY_SHA256="SHA256:CHANGE_ME"
PRODUCTION_DOMAIN="shop.CHANGE_ME.invalid"

# Linux users. Root SSH is disabled after the admin key is installed.
ADMIN_USER="CHANGE_ME"
DEPLOY_USER="shopware-deploy"
SSH_PORT="22"
DISABLE_ROOT_SSH="1"
INSTALL_BASE_DIR="/opt/shopware"

# Shopware and immutable container references. Refresh digests through a
# reviewed dependency update; do not replace them with mutable tags.
SHOPWARE_VERSION="6.7.12.1"
PHP_VERSION="8.4"
SHOPWARE_DOCKER_BASE_IMAGE="ghcr.io/shopware/docker-base:8.4-frankenphp@sha256:95e769f222fc9aab784a3300e0214435c6b8515c946bcb60352f8dc52f2e145b"
SHOPWARE_CLI_IMAGE="ghcr.io/shopware/shopware-cli:latest-php-8.4@sha256:282f93b6b77fb98d529b08178e4351ac264f3bfed46c721a63aac45e3bcb1bf9"
MARIADB_IMAGE="mariadb:11.4@sha256:a794d9eb009e20de605858a11f32f63b4075cbd197c650436f0e3b457e4caed7"
VALKEY_IMAGE="valkey/valkey:8-alpine@sha256:cfe71288f087704b06be45e270afa7a2abbf820093d6b11a23762081f5ff321d"
RABBITMQ_IMAGE="rabbitmq:3-alpine@sha256:d7af1c87c5f1eda13fcfca06db452bf3aeab6619fc3358b68535c0c02c4e52bc"
VARNISH_IMAGE="ghcr.io/shopware/varnish:6.7@sha256:2fe51141415bdaa5dd50b3cfa3bf03d7674f53c8c0a788f3d747bdd857ebcd34"
CADDY_IMAGE="caddy:2-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648"

# Shopware installation defaults
INSTALL_LOCALE="de-DE"
INSTALL_CURRENCY="EUR"
INSTALL_ADMIN_USERNAME="admin"
SHOPWARE_USAGE_DATA_CONSENT="revoked"

# Staging runtime S3. Use credentials restricted to these two staging buckets.
STAGING_S3_ENDPOINT="https://s3.eu-central-1.ionoscloud.com"
STAGING_S3_REGION="eu-central-1"
STAGING_S3_USE_PATH_STYLE="true"
STAGING_S3_PUBLIC_BUCKET="CHANGE_ME-staging-public"
STAGING_S3_PRIVATE_BUCKET="CHANGE_ME-staging-private"
STAGING_S3_PUBLIC_URL="https://CHANGE_ME-staging-public.s3.eu-central-1.ionoscloud.com"
STAGING_S3_ACCESS_KEY="CHANGE_ME"
STAGING_S3_SECRET_KEY="CHANGE_ME"
STAGING_S3_BACKUP_READER_ACCESS_KEY="CHANGE_ME"
STAGING_S3_BACKUP_READER_SECRET_KEY="CHANGE_ME"
STAGING_S3_PROVISIONING_ACCESS_KEY="CHANGE_ME"
STAGING_S3_PROVISIONING_SECRET_KEY="CHANGE_ME"

# Production runtime S3. Never reuse staging buckets or credentials.
PRODUCTION_S3_ENDPOINT="https://s3.eu-central-1.ionoscloud.com"
PRODUCTION_S3_REGION="eu-central-1"
PRODUCTION_S3_USE_PATH_STYLE="true"
PRODUCTION_S3_PUBLIC_BUCKET="CHANGE_ME-production-public"
PRODUCTION_S3_PRIVATE_BUCKET="CHANGE_ME-production-private"
PRODUCTION_S3_PUBLIC_URL="https://CHANGE_ME-production-public.s3.eu-central-1.ionoscloud.com"
PRODUCTION_S3_ACCESS_KEY="CHANGE_ME"
PRODUCTION_S3_SECRET_KEY="CHANGE_ME"
PRODUCTION_S3_BACKUP_READER_ACCESS_KEY="CHANGE_ME"
PRODUCTION_S3_BACKUP_READER_SECRET_KEY="CHANGE_ME"
PRODUCTION_S3_PROVISIONING_ACCESS_KEY="CHANGE_ME"
PRODUCTION_S3_PROVISIONING_SECRET_KEY="CHANGE_ME"

# Staging backup S3. Use a dedicated credential restricted to this bucket.
STAGING_BACKUP_S3_ENDPOINT="https://s3.eu-central-1.ionoscloud.com"
STAGING_BACKUP_S3_REGION="eu-central-1"
STAGING_BACKUP_S3_BUCKET="CHANGE_ME-staging-backups"
STAGING_BACKUP_S3_ACCESS_KEY="CHANGE_ME"
STAGING_BACKUP_S3_SECRET_KEY="CHANGE_ME"
STAGING_BACKUP_HEALTHCHECK_URL="https://hc-ping.com/CHANGE_ME"
STAGING_RESTORE_HEALTHCHECK_URL="https://hc-ping.com/CHANGE_ME"

# Production backup S3. Never reuse staging backup storage or credentials.
PRODUCTION_BACKUP_S3_ENDPOINT="https://s3.eu-central-1.ionoscloud.com"
PRODUCTION_BACKUP_S3_REGION="eu-central-1"
PRODUCTION_BACKUP_S3_BUCKET="CHANGE_ME-production-backups"
PRODUCTION_BACKUP_S3_ACCESS_KEY="CHANGE_ME"
PRODUCTION_BACKUP_S3_SECRET_KEY="CHANGE_ME"
PRODUCTION_BACKUP_HEALTHCHECK_URL="https://hc-ping.com/CHANGE_ME"
PRODUCTION_RESTORE_HEALTHCHECK_URL="https://hc-ping.com/CHANGE_ME"

# Backup and automated restore-test schedules
BACKUP_RETENTION_DAYS="30"
BACKUP_HOUR="2"
BACKUP_MINUTE="30"
RESTORE_TEST_DAY="Sun"
RESTORE_TEST_HOUR="4"
RESTORE_TEST_MINUTE="30"

# Optional staging Shopware Store credentials. Keep empty when unused.
STAGING_SHOPWARE_STORE_ACCOUNT_EMAIL=""
STAGING_SHOPWARE_STORE_ACCOUNT_PASSWORD=""
STAGING_SHOPWARE_STORE_SHOP_SECRET=""
STAGING_SHOPWARE_STORE_LICENSE_DOMAIN=""

# Optional production Shopware Store credentials. Keep empty when unused.
PRODUCTION_SHOPWARE_STORE_ACCOUNT_EMAIL=""
PRODUCTION_SHOPWARE_STORE_ACCOUNT_PASSWORD=""
PRODUCTION_SHOPWARE_STORE_SHOP_SECRET=""
PRODUCTION_SHOPWARE_STORE_LICENSE_DOMAIN=""
