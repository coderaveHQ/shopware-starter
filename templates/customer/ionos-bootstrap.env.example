# Copy this file to ionos-bootstrap.env only while provisioning IONOS
# contract-owned buckets. Use one temporary contract-owner/admin key pair.
# The file is local-only, must never be copied to a server, and should be
# removed after scripts/04-setup-s3-storage.sh has completed successfully.

IONOS_S3_OWNER_ACCESS_KEY="CHANGE_ME"
IONOS_S3_OWNER_SECRET_KEY="CHANGE_ME"
